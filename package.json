{
  "name": "code-colony",
  "version": "0.1.0",
  "private": true,
  "description": "Code Colony — where your repo becomes a living company.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "landing:dev": "npm --prefix apps/landing run dev",
