    "landing:typecheck": "npm --prefix apps/landing run typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "@ai-sdk/openai-compatible": "^2.0.42",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/better-auth": "^0.12.1",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/migrations": "^0.3.4",
    "@convex-dev/persistent-text-streaming": "^0.3.2",
    "@convex-dev/r2": "^0.10.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/sharded-counter": "^0.2.0",
    "@convex-dev/workflow": "^0.3.12",
    "@convex-dev/workpool": "^0.4.6",
    "@mastra/core": "^1.29.0",
    "@next/eslint-plugin-next": "latest",
    "better-auth": "^1.6.9",
    "convex": "^1.31.5",
    "next": "latest",
    "openai": "^6.35.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
