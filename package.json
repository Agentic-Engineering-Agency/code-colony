{
  "name": "code-colony",
  "version": "0.1.0",
  "private": true,
  "description": "Code Colony — where your repo becomes a living company.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "landing:typecheck": "npm --prefix apps/landing run typecheck",
    "iac:diff": "alchemy diff",
    "iac:deploy": "alchemy deploy",
    "iac:destroy": "alchemy destroy",
    "dev:tanstack": "vite dev --port 3001 --config vite.config.mts",
    "build:tanstack": "vite build --config vite.config.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.54",
    "@ai-sdk/openai-compatible": "^2.0.42",
    "@ai-sdk/provider-utils": "^4.0.25",
    "@akshatgiri/convex-orchestrator": "^0.1.5",
    "@convex-dev/action-cache": "^0.3.0",
    "@convex-dev/action-retrier": "^0.3.0",
    "@convex-dev/agent": "^0.6.1",
    "@convex-dev/aggregate": "^0.2.1",
    "@convex-dev/better-auth": "^0.12.1",
    "@convex-dev/crons": "^0.2.0",
    "@convex-dev/migrations": "^0.3.4",
    "@convex-dev/persistent-text-streaming": "^0.3.2",
    "@convex-dev/r2": "^0.10.1",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.3",
    "@convex-dev/sharded-counter": "^0.2.0",
    "@convex-dev/workflow": "^0.3.12",
    "@convex-dev/workpool": "^0.4.6",
    "@dodopayments/convex": "^0.2.11",
    "@mastra/core": "^1.29.0",
    "@mzedstudio/llm-cache": "^0.1.0",
    "@next/eslint-plugin-next": "latest",
    "@steel-dev/convex": "^0.2.3",
    "@tanstack/react-router": "1.168.25",
    "@tanstack/react-start": "1.167.51",
    "@waynesutton/agent-ready": "^0.2.6",
    "ai": "^6.0.172",
    "better-auth": "^1.6.9",
    "convex": "^1.31.5",
    "convex-helpers": "^0.1.115",
    "convex-timeline": "^0.1.2",
    "convex-webhook-sender": "^1.1.0",
    "next": "latest",
    "openai": "^6.35.0",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.34.0",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "vite": "8.0.10",
    "vitest": "latest",
    "wrangler": "4.86.0"
  },
  "engines": {
    "node": ">=20"
  }
}
