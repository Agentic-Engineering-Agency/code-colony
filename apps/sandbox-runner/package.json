{
  "name": "@code-colony/sandbox-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that fronts @cloudflare/sandbox for Code Colony agents.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=.dryrun",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/sandbox": "^0.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.86.0"
  },
  "engines": {
    "node": ">=20"
  }
}
