# Code Colony local development template.
# Copy to .env.local for Next/TanStack local work, and set Convex-only values with `npx convex env set`.
# Never put real production secrets in this example file.

# App URLs
SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TANSTACK_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:5173

# Convex
CONVEX_DEPLOYMENT=dev:replace-with-your-convex-deployment
CONVEX_URL=https://replace-with-your-convex-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://replace-with-your-convex-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://replace-with-your-convex-site.convex.site
CONVEX_DEPLOY_KEY=replace-in-github-actions-only

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
AUTH_EMAIL_FROM="Code Colony <onboarding@resend.dev>"
AUTH_EMAIL_REPLY_TO=support@example.com

# AI providers / Mastra
OPENAI_API_KEY=replace-with-openai-key-if-used
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=qwen/qwen3-coder:free
MASTRA_LOG_LEVEL=info

# Dodo Payments
DODO_PAYMENTS_API_KEY=replace-with-dodo-test-key
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_SECRET=replace-with-dodo-webhook-secret

# Resend
RESEND_API_KEY=replace-with-resend-test-key
RESEND_FROM_EMAIL="Code Colony <onboarding@resend.dev>"
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# Cloudflare R2 / Convex R2 component
R2_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
R2_BUCKET=code-colony-dev
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_TOKEN=replace-with-cloudflare-r2-token
R2_PUBLIC_BASE_URL=https://assets.example.com

# Cloudflare / Alchemy IaC
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-in-local-shell-or-github-actions-only
ALCHEMY_STAGE=dev
ALCHEMY_STATE_STORE=local
ALCHEMY_PASSWORD=replace-with-local-dev-state-password
ALCHEMY_STATE_TOKEN=replace-with-cloudflare-state-token-for-ci

# Sandbox runner / webhooks / automation
SANDBOX_RUNNER_URL=http://localhost:8787
SANDBOX_HMAC_KEY=replace-with-local-hmac-key
WEBHOOK_SIGNING_SECRET=replace-with-generic-outbound-webhook-secret
AUTOMATION_DRY_RUN=1

# PostHog observability
POSTHOG_API_KEY=phc_replace_with_server_project_key
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_browser_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_DISABLED=0

# Optional cloud browser integration
STEEL_API_KEY=replace-with-steel-key-if-enabled
